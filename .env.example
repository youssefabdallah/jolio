# Jolio — local container stack (copy to .env; `make up` does it for you)
COMPOSE_PROJECT_NAME=jolio

# Host ports
API_PORT=8000
WEB_PORT=3000
ADMINER_PORT=8081

# Laravel (empty APP_KEY = entrypoint generates an ephemeral one)
APP_ENV=production
APP_DEBUG=false
APP_KEY=

# Postgres (consumed by the db service and passed through to the api service)
POSTGRES_DB=jolio
POSTGRES_USER=jolio
POSTGRES_PASSWORD=change-me-in-.env
POSTGRES_PORT=5432

# Browser -> API base URL baked into / shown by web
NEXT_PUBLIC_API_URL=http://localhost:8000
