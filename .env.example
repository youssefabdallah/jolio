# Jolio — local container stack (copy to .env; `make up` does it for you)
COMPOSE_PROJECT_NAME=jolio

# Host ports
API_PORT=8000
WEB_PORT=3000
ADMINER_PORT=8081

# Laravel (empty APP_KEY = entrypoint generates an ephemeral one)
APP_ENV=production
APP_DEBUG=false
APP_KEY=

# Postgres (consumed by the db service and passed through to the api service)
POSTGRES_DB=jolio
POSTGRES_USER=jolio
POSTGRES_PASSWORD=change-me-in-.env
POSTGRES_PORT=5432

# Browser -> API base URL baked into / shown by web
NEXT_PUBLIC_API_URL=http://localhost:8000
# Server-to-server API base (web container -> api service; never exposed to the browser)
API_BASE_URL=http://api

# OAuth (server code flow): register http://localhost:8000/api/v1/auth/google/callback
# in Google Console, then fill these in. Empty = OAuth endpoints fail closed (503).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
FRONTEND_URL=http://localhost:3000
