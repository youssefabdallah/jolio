{
    "openapi": "3.0.0",
    "info": {
        "title": "Jolio API",
        "description": "AI-powered job folio (SPECS v1.0).",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://localhost:8000",
            "description": "Local Docker stack"
        }
    ],
    "paths": {
        "/api/v1/auth/login": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Sign in with email and password",
                "description": "Sign in with a local credential (SPECS FR-1). Returns 200: signing in\ncreates nothing, so 201 would be dishonest.",
                "operationId": "loginWithCredentials",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "email",
                                    "password"
                                ],
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "alex@dev.internal"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "s3cret-pass"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Signed in",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/AuthResponse"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Invalid credentials",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation failed",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    },
                    "429": {
                        "description": "Too many requests"
                    }
                }
            }
        },
        "/api/v1/auth/logout": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Revoke the current API token",
                "description": "Sign out by revoking the token used for this request. Other sessions\nissued to the same user stay valid.",
                "operationId": "logout",
                "responses": {
                    "204": {
                        "description": "Token revoked"
                    },
                    "401": {
                        "description": "Unauthenticated",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/api/user": {
            "get": {
                "tags": [
                    "Auth"
                ],
                "summary": "Current session user",
                "description": "Session lookup for the SPA shell and its auth gate. Returns the public\nuser schema (id, display name, email, provider, avatar) — never the\nraw model, so provider ids and timestamps stay server-side.",
                "operationId": "currentUser",
                "responses": {
                    "200": {
                        "description": "Signed in",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "required": [
                                        "id",
                                        "display_name",
                                        "email",
                                        "provider"
                                    ],
                                    "properties": {
                                        "id": {
                                            "type": "string",
                                            "example": "01JABCD1234EFGH5678JKLMNP"
                                        },
                                        "display_name": {
                                            "type": "string",
                                            "example": "Alex Dev"
                                        },
                                        "email": {
                                            "type": "string",
                                            "format": "email",
                                            "example": "alex@dev.internal"
                                        },
                                        "provider": {
                                            "type": "string",
                                            "example": "google",
                                            "enum": [
                                                "local",
                                                "google"
                                            ]
                                        },
                                        "avatar_url": {
                                            "type": "string",
                                            "nullable": true
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthenticated",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/api/v1/auth/{provider}/callback": {
            "get": {
                "tags": [
                    "Auth"
                ],
                "summary": "Complete the OAuth handshake and sign in",
                "description": "Exchanges the provider code, finds-or-creates the user, and redirects to the SPA with a fresh token in the URL fragment (fragments never reach servers or logs). Known failures (e.g. email already taken) redirect instead with an error code fragment the SPA maps to its own copy.",
                "operationId": "oauthCallback",
                "parameters": [
                    {
                        "name": "provider",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "enum": [
                                "google"
                            ]
                        }
                    },
                    {
                        "name": "code",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "302": {
                        "description": "Redirect to the SPA with the token"
                    },
                    "422": {
                        "description": "Unsupported provider",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    },
                    "429": {
                        "description": "Too many requests"
                    },
                    "502": {
                        "description": "Provider handshake failed",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/auth/{provider}/redirect": {
            "get": {
                "tags": [
                    "Auth"
                ],
                "summary": "Start the OAuth handshake at the provider",
                "description": "Redirect the browser to the OAuth provider (server code flow entry).",
                "operationId": "oauthRedirect",
                "parameters": [
                    {
                        "name": "provider",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "enum": [
                                "google"
                            ]
                        }
                    }
                ],
                "responses": {
                    "302": {
                        "description": "Redirect to the provider"
                    },
                    "422": {
                        "description": "Unsupported provider",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    },
                    "429": {
                        "description": "Too many requests"
                    },
                    "503": {
                        "description": "OAuth not configured",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/auth/register": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Register with email and password",
                "description": "Register a local-credential account and sign it in (SPECS FR-1).",
                "operationId": "registerWithCredentials",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "display_name",
                                    "email",
                                    "password",
                                    "password_confirmation"
                                ],
                                "properties": {
                                    "display_name": {
                                        "type": "string",
                                        "example": "Alex Dev",
                                        "maxLength": 255
                                    },
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "alex@dev.internal"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "s3cret-pass",
                                        "minLength": 8
                                    },
                                    "password_confirmation": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "s3cret-pass"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Registered",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/AuthResponse"
                                }
                            }
                        }
                    },
                    "409": {
                        "description": "Email taken",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation failed",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    },
                    "429": {
                        "description": "Too many requests"
                    }
                }
            }
        },
        "/api/profile": {
            "get": {
                "tags": [
                    "Profile"
                ],
                "summary": "Read the caller's candidate profile",
                "description": "Session-scoped profile read (SPECS FR-4, US-201).\n\nLooks up by the token's user id, so callers can only ever read\ntheir own row. Missing profiles answer 200 with null data — the\neditor renders a blank form instead of an error page.",
                "operationId": "showProfile",
                "responses": {
                    "200": {
                        "description": "Profile or empty",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "required": [
                                        "data"
                                    ],
                                    "properties": {
                                        "data": {
                                            "oneOf": [
                                                {
                                                    "$ref": "#/components/schemas/ProfileResponse"
                                                }
                                            ],
                                            "nullable": true
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthenticated",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            },
            "put": {
                "tags": [
                    "Profile"
                ],
                "summary": "Create or replace the caller's candidate profile",
                "description": "Replace the caller's candidate profile (SPECS FR-4, US-201).\n\nOwner-only by construction: the user id comes from the Sanctum\ntoken and the request passes ProfilePolicy on existing rows, so a\n200 here always means \"your profile was stored\".",
                "operationId": "updateProfile",
                "requestBody": {
                    "description": "Per-step partial document: only the named step section is validated, the rest merges with the stored profile.",
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "current_step": {
                                        "type": "string",
                                        "nullable": true,
                                        "enum": [
                                            "contact",
                                            "headline",
                                            "skills",
                                            "experience",
                                            "education",
                                            "languages",
                                            "review"
                                        ]
                                    },
                                    "contact": {
                                        "required": [
                                            "full_name"
                                        ],
                                        "properties": {
                                            "full_name": {
                                                "type": "string",
                                                "example": "Alex Dev",
                                                "maxLength": 120
                                            },
                                            "email": {
                                                "type": "string",
                                                "format": "email"
                                            },
                                            "phone": {
                                                "type": "string"
                                            },
                                            "city": {
                                                "type": "string"
                                            },
                                            "country": {
                                                "type": "string"
                                            },
                                            "website": {
                                                "type": "string"
                                            }
                                        },
                                        "type": "object"
                                    },
                                    "headline": {
                                        "type": "string",
                                        "nullable": true,
                                        "maxLength": 140
                                    },
                                    "summary": {
                                        "type": "string",
                                        "nullable": true,
                                        "maxLength": 2000
                                    },
                                    "skills": {
                                        "type": "array",
                                        "items": {
                                            "type": "object"
                                        },
                                        "nullable": true
                                    },
                                    "experience": {
                                        "type": "array",
                                        "items": {
                                            "type": "object"
                                        },
                                        "nullable": true
                                    },
                                    "education": {
                                        "type": "array",
                                        "items": {
                                            "type": "object"
                                        },
                                        "nullable": true
                                    },
                                    "languages": {
                                        "type": "array",
                                        "items": {
                                            "type": "object"
                                        },
                                        "nullable": true
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Profile stored",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "required": [
                                        "data"
                                    ],
                                    "properties": {
                                        "data": {
                                            "required": [
                                                "profile"
                                            ],
                                            "properties": {
                                                "profile": {
                                                    "$ref": "#/components/schemas/ProfileResponse"
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthenticated",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "Not the profile owner",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation failed",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    },
                    "429": {
                        "description": "Too many requests"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        }
    },
    "components": {
        "schemas": {
            "ErrorResponse": {
                "required": [
                    "error"
                ],
                "properties": {
                    "error": {
                        "required": [
                            "code",
                            "message"
                        ],
                        "properties": {
                            "code": {
                                "description": "Uniform API error shape rendered centrally for Domain violations.",
                                "type": "string",
                                "example": "EMAIL_TAKEN"
                            },
                            "message": {
                                "type": "string",
                                "example": "An account with this email address already exists."
                            },
                            "details": {
                                "type": "object",
                                "nullable": true
                            }
                        },
                        "type": "object"
                    }
                },
                "type": "object"
            },
            "AuthResponse": {
                "required": [
                    "data"
                ],
                "properties": {
                    "data": {
                        "required": [
                            "user",
                            "token"
                        ],
                        "properties": {
                            "user": {
                                "required": [
                                    "id",
                                    "display_name",
                                    "email",
                                    "provider"
                                ],
                                "properties": {
                                    "id": {
                                        "description": "Successful authentication payload: the user plus a one-time token.",
                                        "type": "string",
                                        "example": "01JABCD1234EFGH5678JKLMNP"
                                    },
                                    "display_name": {
                                        "type": "string",
                                        "example": "Alex Dev"
                                    },
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "alex@dev.internal"
                                    },
                                    "provider": {
                                        "type": "string",
                                        "example": "local",
                                        "enum": [
                                            "local",
                                            "google"
                                        ]
                                    },
                                    "avatar_url": {
                                        "type": "string",
                                        "nullable": true
                                    }
                                },
                                "type": "object"
                            },
                            "token": {
                                "type": "string",
                                "example": "1|aBcDeFgHiJkLmNoPqRsTuVwXyZ"
                            }
                        },
                        "type": "object"
                    }
                },
                "type": "object"
            },
            "ProfileResponse": {
                "required": [
                    "id",
                    "contact"
                ],
                "properties": {
                    "id": {
                        "description": "Candidate profile document returned by PUT /api/profile.",
                        "type": "string",
                        "example": "01JABCD1234EFGH5678JKLMNP"
                    },
                    "contact": {
                        "required": [
                            "full_name"
                        ],
                        "properties": {
                            "full_name": {
                                "type": "string",
                                "example": "Alex Dev"
                            },
                            "email": {
                                "type": "string",
                                "format": "email",
                                "nullable": true
                            },
                            "phone": {
                                "type": "string",
                                "nullable": true
                            },
                            "city": {
                                "type": "string",
                                "nullable": true
                            },
                            "country": {
                                "type": "string",
                                "nullable": true
                            },
                            "website": {
                                "type": "string",
                                "nullable": true
                            }
                        },
                        "type": "object"
                    },
                    "headline": {
                        "type": "string",
                        "nullable": true,
                        "maxLength": 140
                    },
                    "summary": {
                        "type": "string",
                        "nullable": true,
                        "maxLength": 2000
                    },
                    "skills": {
                        "type": "array",
                        "items": {
                            "type": "object"
                        },
                        "nullable": true
                    },
                    "experience": {
                        "type": "array",
                        "items": {
                            "type": "object"
                        },
                        "nullable": true
                    },
                    "education": {
                        "type": "array",
                        "items": {
                            "type": "object"
                        },
                        "nullable": true
                    },
                    "languages": {
                        "type": "array",
                        "items": {
                            "type": "object"
                        },
                        "nullable": true
                    },
                    "current_step": {
                        "type": "string",
                        "nullable": true,
                        "enum": [
                            "contact",
                            "headline",
                            "skills",
                            "experience",
                            "education",
                            "languages",
                            "review"
                        ]
                    },
                    "completion_percent": {
                        "type": "integer",
                        "maximum": 100,
                        "minimum": 0
                    }
                },
                "type": "object"
            }
        }
    },
    "tags": [
        {
            "name": "Auth",
            "description": "Auth"
        },
        {
            "name": "Profile",
            "description": "Profile"
        }
    ]
}