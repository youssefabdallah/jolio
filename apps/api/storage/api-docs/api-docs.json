{
    "openapi": "3.0.0",
    "info": {
        "title": "Jolio API",
        "description": "AI-powered job folio (SPECS v1.0).",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://localhost:8000",
            "description": "Local Docker stack"
        }
    ],
    "paths": {
        "/api/v1/auth/login": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Sign in with email and password",
                "description": "Sign in with a local credential (SPECS FR-1). Returns 200: signing in\ncreates nothing, so 201 would be dishonest.",
                "operationId": "loginWithCredentials",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "email",
                                    "password"
                                ],
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "alex@dev.internal"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "s3cret-pass"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Signed in",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/AuthResponse"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Invalid credentials",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation failed",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    },
                    "429": {
                        "description": "Too many requests"
                    }
                }
            }
        },
        "/api/v1/auth/logout": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Revoke the current API token",
                "description": "Sign out by revoking the token used for this request. Other sessions\nissued to the same user stay valid.",
                "operationId": "logout",
                "responses": {
                    "204": {
                        "description": "Token revoked"
                    },
                    "401": {
                        "description": "Unauthenticated",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/api/v1/auth/{provider}/callback": {
            "get": {
                "tags": [
                    "Auth"
                ],
                "summary": "Complete the OAuth handshake and sign in",
                "description": "Exchanges the provider code, finds-or-creates the user, and redirects to the SPA with a fresh token in the URL fragment (fragments never reach servers or logs). Known failures (e.g. email already taken) redirect instead with an error code fragment the SPA maps to its own copy.",
                "operationId": "oauthCallback",
                "parameters": [
                    {
                        "name": "provider",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "enum": [
                                "google"
                            ]
                        }
                    },
                    {
                        "name": "code",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "302": {
                        "description": "Redirect to the SPA with the token"
                    },
                    "422": {
                        "description": "Unsupported provider",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    },
                    "429": {
                        "description": "Too many requests"
                    },
                    "502": {
                        "description": "Provider handshake failed",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/auth/{provider}/redirect": {
            "get": {
                "tags": [
                    "Auth"
                ],
                "summary": "Start the OAuth handshake at the provider",
                "description": "Redirect the browser to the OAuth provider (server code flow entry).",
                "operationId": "oauthRedirect",
                "parameters": [
                    {
                        "name": "provider",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "enum": [
                                "google"
                            ]
                        }
                    }
                ],
                "responses": {
                    "302": {
                        "description": "Redirect to the provider"
                    },
                    "422": {
                        "description": "Unsupported provider",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    },
                    "429": {
                        "description": "Too many requests"
                    },
                    "503": {
                        "description": "OAuth not configured",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/auth/register": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Register with email and password",
                "description": "Register a local-credential account and sign it in (SPECS FR-1).",
                "operationId": "registerWithCredentials",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "display_name",
                                    "email",
                                    "password",
                                    "password_confirmation"
                                ],
                                "properties": {
                                    "display_name": {
                                        "type": "string",
                                        "example": "Alex Dev",
                                        "maxLength": 255
                                    },
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "alex@dev.internal"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "s3cret-pass",
                                        "minLength": 8
                                    },
                                    "password_confirmation": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "s3cret-pass"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Registered",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/AuthResponse"
                                }
                            }
                        }
                    },
                    "409": {
                        "description": "Email taken",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation failed",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    },
                    "429": {
                        "description": "Too many requests"
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "ErrorResponse": {
                "required": [
                    "error"
                ],
                "properties": {
                    "error": {
                        "required": [
                            "code",
                            "message"
                        ],
                        "properties": {
                            "code": {
                                "description": "Uniform API error shape rendered centrally for Domain violations.",
                                "type": "string",
                                "example": "EMAIL_TAKEN"
                            },
                            "message": {
                                "type": "string",
                                "example": "An account with this email address already exists."
                            },
                            "details": {
                                "type": "object",
                                "nullable": true
                            }
                        },
                        "type": "object"
                    }
                },
                "type": "object"
            },
            "AuthResponse": {
                "required": [
                    "data"
                ],
                "properties": {
                    "data": {
                        "required": [
                            "user",
                            "token"
                        ],
                        "properties": {
                            "user": {
                                "required": [
                                    "id",
                                    "display_name",
                                    "email",
                                    "provider"
                                ],
                                "properties": {
                                    "id": {
                                        "description": "Successful authentication payload: the user plus a one-time token.",
                                        "type": "string",
                                        "example": "01JABCD1234EFGH5678JKLMNP"
                                    },
                                    "display_name": {
                                        "type": "string",
                                        "example": "Alex Dev"
                                    },
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "alex@dev.internal"
                                    },
                                    "provider": {
                                        "type": "string",
                                        "example": "local",
                                        "enum": [
                                            "local",
                                            "google"
                                        ]
                                    },
                                    "avatar_url": {
                                        "type": "string",
                                        "nullable": true
                                    }
                                },
                                "type": "object"
                            },
                            "token": {
                                "type": "string",
                                "example": "1|aBcDeFgHiJkLmNoPqRsTuVwXyZ"
                            }
                        },
                        "type": "object"
                    }
                },
                "type": "object"
            }
        }
    },
    "tags": [
        {
            "name": "Auth",
            "description": "Auth"
        }
    ]
}